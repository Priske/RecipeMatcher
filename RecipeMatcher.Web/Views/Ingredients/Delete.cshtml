@model Ingredient

<h1>Delete</h1>

<p>Are you sure you want to delete this Ingredient?</p>

<dl>
    <dt>Name</dt>
    <dd>@Model.Name</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit">Delete</button>
    <a asp-action="Index">Cancel</a>
</form>