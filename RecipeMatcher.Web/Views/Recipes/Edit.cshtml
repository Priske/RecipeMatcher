@model EditRecipeViewModel

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />

    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label asp-for="PreparationMinutes"></label>
    <input asp-for="PreparationMinutes" />
    <span asp-validation-for="PreparationMinutes"></span>

    <ul>
        @foreach (var ingredient in Model.Ingredients)
        {
            <li>
                <label>
                    <input type="checkbox" name="ingredientIds" value="@ingredient.Id"
                           checked="@(ingredient.Selected ? "checked" : null)" />

                    @ingredient.Name
                </label>
            </li>
        }
    </ul>

    <div asp-validation-summary="All"></div>

    <button type="submit">Save</button>
</form>