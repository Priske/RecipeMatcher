@model Recipe

<form asp-action="Create" method="post">
    <p>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" style="color: red; font-weight: bold;"></span>
        <br />
        <label asp-for="PreparationMinutes"></label>
        <input asp-for="PreparationMinutes" />
        <span asp-validation-for="PreparationMinutes" style="color: red; font-weight: bold;"></span>
        @foreach (var ingredient in ViewBag.Ingredients)
        {
            <li>
                <label>
                    <input type="checkbox" name="ingredientIds" value="@ingredient.Id" />
                    @ingredient.Name
                </label>
            </li>
        }
    </p>

    <button type="submit">Create</button>
</form>