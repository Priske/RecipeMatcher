@model MatcherViewModel

<h1>Choose pantry ingredients</h1>

<form asp-action="Index" method="post">
    @foreach (var ingredient in Model.Ingredients)
    {
        <div>
            <label>
                <input type="checkbox" name="ingredientIds" value="@ingredient.Id" />

                @ingredient.Name
            </label>
        </div>
    }

    <button type="submit">Submit</button>

    @if (Model.Recipes.Any())
    {
        <h2>Matching Recipes</h2>
        <ul>
            @foreach (var recipe in Model.Recipes)
            {
                <li>id: @recipe.RecipeId - name: @recipe.Name - minutes: @recipe.PreparationMinutes
                    @if (recipe.MissingIngredients.Any())
                    {
                        <ul>
                            @foreach (var missingIngredient in recipe.MissingIngredients)
                            {
                                <li>Missing ingredient: @missingIngredient.Name</li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    }
</form>